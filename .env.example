HASTA_POSTGRES_PASSWORD=REPLACE_WITH_A_LOCAL_URL_SAFE_PASSWORD
HASTA_DEVICE_PEPPER=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
HASTA_AUTH_SECRET=REPLACE_WITH_64_DIFFERENT_RANDOM_HEX_CHARACTERS
HASTA_QUICK_TEST_ACCOUNTS_ENABLED=false
# Keep disabled until the full S2 client and recovery paths are qualified.
HASTA_AUTH_GOOGLE_LINK_ENABLED=false
# Only the explicit local QR QA launcher can activate this flag.
HASTA_AUTH_QR_TRANSFER_ENABLED=false
HASTA_GOOGLE_CLIENT_ID=
HASTA_GOOGLE_CLIENT_SECRET=
HASTA_GOOGLE_REDIRECT_URI=
# [PROPOSAL] Auth policy defaults. Live deployments inject their remote configuration.
HASTA_ACCESS_TOKEN_TTL_SECONDS=900
HASTA_REFRESH_TOKEN_TTL_SECONDS=2592000
HASTA_DEVICE_TOKEN_TTL_SECONDS=31536000
HASTA_DEVICE_REGISTER_PER_HOUR=10
HASTA_GUEST_CREATE_PER_HOUR=3
